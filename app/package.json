{
  "name": "saints-hud",
  "productName": "Chud Hud",
  "version": "0.3.6",
  "private": true,
  "description": "St. Clair Saints broadcast control room and OBS overlays with live Rocket League and League of Legends data, plus screen OCR for other games.",
  "author": "St. Clair Saints Broadcast",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "lan": "node -e \"process.env.HOST='0.0.0.0';require('./server.js')\"",
    "test": "electron test/ocr-selftest.js",
    "dist": "electron-builder --win nsis portable --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "ca.stclair.saintshud",
    "productName": "Chud Hud",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "league.js",
      "fields.js",
      "minecraft.js",
      "ocr.js",
      "test/ocr-selftest.js",
      "build/icon.png",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "McJanrey",
        "repo": "saints-hud",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "artifactName": "ChudHud-Setup-${version}.exe",
      "oneClick": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Chud Hud"
    },
    "portable": {
      "artifactName": "ChudHud-portable-${version}.exe"
    }
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.9",
    "tesseract.js": "^5.1.1"
  }
}
